{
  "name": "faclab-web",
  "private": true,
  "version": "2.0.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "npx prettier src tests playwright.config.ts --check",
    "prettier:fix": "npm run prettier -- --write",
    "format": "npm run prettier:fix && npm run lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:contract": "OPENAPI_URL=${OPENAPI_URL:-http://localhost:3000/openapi.json} vitest run src/test/apiContract.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:update": "playwright test visual --update-snapshots",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.2.0",
    "@popperjs/core": "^2.11.8",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.8.5",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.7",
    "framer-motion": "^12.0.0",
    "i18next": "^22.4.13",
    "lodash": "^4.18.1",
    "miragejs": "^0.1.48",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.73.0",
    "react-i18next": "^12.2.0",
    "react-icons": "^4.8.0",
    "react-modal": "^3.16.3",
    "react-popper": "^2.3.0",
    "react-portal": "^4.2.2",
    "react-router-dom": "^6.30.6",
    "react-select": "^5.10.0",
    "twin.macro": "^3.4.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.14.191",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-modal": "^3.13.1",
    "@types/react-portal": "^4.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.29",
    "prettier": "^2.8.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
