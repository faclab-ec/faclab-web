# Sirve el build de Vite detrás del proxy de entrada (ADR-0011): sin TLS ni API
# de administración, con fallback a index.html para las rutas del SPA.
{
	admin off
	auto_https off
	persist_config off
	# Sin TLS no hay certificados que guardar: Caddy no escribe en disco
	storage_check off
	storage_clean_interval off
}

:8080 {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
	}

	handle /health {
		respond "ok" 200
	}

	# Lo escribe entrypoint.sh al arrancar: nunca en caché, para que un cambio
	# de URLs se vea en la siguiente carga
	handle /config.js {
		root * /srv/runtime
		header Cache-Control "no-store"
		file_server
	}

	# Nombres con hash: caché permanente. Si no existe es 404, no index.html,
	# para que un chunk viejo falle claro en lugar de cargar HTML como JS
	handle /assets/* {
		root * /srv/app
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/app
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
